{
  "name": "wp-vite-plugin",
  "version": "0.0.1",
  "description": "Vite plugin and CLI for WordPress plugin development (wp-scripts parity, script modules, HMR)",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "wp-vite": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "terser": "^5.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^26.6.4",
    "sass-embedded": "^1.105.1",
    "terser": "^5.51.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.4.0",
    "cac": "^7.0.1",
    "estree-walker": "^3.0.3",
    "fflate": "^0.8.3",
    "gettext-parser": "^9.1.1",
    "is-reference": "^3.0.3",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.4.3",
    "picocolors": "^1.1.1",
    "rtlcss": "^4.3.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependenciesMeta": {
    "terser": {
      "optional": true
    }
  }
}
